# Database
POSTGRES_USER=wijnpick
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=wijnpick
DATABASE_URL=postgresql://wijnpick:<generate-a-strong-password>@db:5432/wijnpick

# Google Gemini
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EXTRACTION_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Backend
SECRET_KEY=<generate-a-random-secret>
MATCH_THRESHOLD=0.80
UPLOAD_DIR=/app/uploads

# Auth — password for the auto-created admin account
# Both SECRET_KEY and ADMIN_PASSWORD are REQUIRED — the app will refuse to start without them.
ADMIN_PASSWORD=<choose-a-strong-admin-password>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage backend ("local" or "s3") — local stores files on disk, s3 uses any S3-compatible service
STORAGE_BACKEND=local
# S3 settings (only needed when STORAGE_BACKEND=s3)
# For OCI Object Storage, use: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_PRESIGNED_URL_EXPIRY=3600

# Kafka (event logging)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Langfuse (LLM observability) — leave empty to disable
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Sentry (error tracking) — leave empty to disable
SENTRY_DSN=
VITE_SENTRY_DSN=

# Domain (for deployment — Caddy handles HTTPS automatically)
DOMAIN=dockscan.nl

# Shopify channel orders (Fase 3) — leave empty to disable the integration.
# OAuth app (Dev Dashboard → Credentials): API_KEY = Client ID, API_SECRET =
# Client secret. The per-shop access token is obtained via OAuth and stored in
# the database — there is deliberately no global access-token env var.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-01
# Base64url-encoded 32-byte key used only by the backend to encrypt per-shop
# OAuth tokens. Keep the real value in the production secret environment.
CHANNEL_CREDENTIAL_ENCRYPTION_KEY=

# bol Retailer API — single-account bootstrap. Keep real credentials only in
# the server environment; never commit or expose them to the frontend.
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=
BOL_TOKEN_URL=https://login.bol.com/token
BOL_API_BASE_URL=https://api.bol.com/retailer
BOL_DEMO_BASE_URL=https://api.bol.com/retailer-demo

# Veloyd label verification — keep the real key only in the server environment.
VELOYD_API_KEY=
VELOYD_API_BASE_URL=https://app.veloyd.nl/api
