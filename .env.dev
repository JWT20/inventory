# Local development environment — THROWAWAY DUMMY VALUES ONLY.
# Safe to commit. NEVER put real secrets here (use .env.dev.local, gitignored).
# Loaded by docker-compose.dev.yml.  Start with:  make dev

# Database
POSTGRES_USER=wijnpick
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=wijnpick
DATABASE_URL=postgresql://wijnpick:devpassword@db:5432/wijnpick

# Backend — non-default dummies so the app boots (config.py rejects the
# INSECURE-DEV-KEY sentinel, so these must be set to *something*).
SECRET_KEY=dev-secret-key-not-for-production-change-me
ADMIN_PASSWORD=devadmin
MATCH_THRESHOLD=0.80
UPLOAD_DIR=/app/uploads
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_DISPATCH_INTERVAL_SECONDS=5

# Google Gemini — empty by default: the app boots, but AI scan/embedding is
# disabled. To use real AI locally, put GEMINI_API_KEY=... in .env.dev.local
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EXTRACTION_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Storage — local disk
STORAGE_BACKEND=local

# Kafka — empty = event logging disabled in dev (use `make dev-events` to enable)
KAFKA_BOOTSTRAP_SERVERS=

# Observability — off in dev
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# Domain empty = dev CORS mode (permissive)
DOMAIN=

# bol — empty by default. Put real development credentials only in the
# gitignored .env.dev.local when an authenticated demo check is needed.
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=
BOL_TOKEN_URL=https://login.bol.com/token
BOL_API_BASE_URL=https://api.bol.com/retailer
BOL_DEMO_BASE_URL=https://api.bol.com/retailer-demo
